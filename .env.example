# Copy these into Vercel: Project > Settings > Environment Variables.
# Without the Supabase values the site runs in demo mode (sample stores only, no dashboard).

# Platform name shown on the site
NEXT_PUBLIC_PLATFORM_NAME=TamKar

# Your main domain, without https://. Leave empty until the domain is connected.
# When set, stores open at <name>.<this domain>
NEXT_PUBLIC_ROOT_DOMAIN=

# From Supabase: Project Settings > API Keys (and Data API for the URL)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret. Never share it.
SUPABASE_SECRET_KEY=

# Copy these into Vercel: Project > Settings > Environment Variables.
# Leave the Supabase values empty to run in demo mode with sample stores.

# Platform name shown on the site (change when the final name is chosen)
NEXT_PUBLIC_PLATFORM_NAME=TamKar

# Your main domain, without https:// (stores live at <name>.<this domain>)
NEXT_PUBLIC_ROOT_DOMAIN=tamkar.com

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Never share it or put it in front-end code.
SUPABASE_SERVICE_ROLE_KEY=
